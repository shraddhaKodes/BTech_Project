# copy to server/.env  (all optional)
PORT=4000
UDP_PORT=5005                 # legacy single stream (v1 packets, e.g. stream_v123_udp.m)
UDP_HOST=0.0.0.0
MONGO_URI=mongodb://127.0.0.1:27017/ieee123
V_BASE_LN=2401.78
WS_EMIT_HZ=10
DB_SAVE_INTERVAL_MS=1000
RETENTION_HOURS=24

# --- two-PMU synchronisation pipeline ---
PMU_ENABLED=1                 # PMU UDP ports come from server/data/sectors.json (5011 / 5012)
SYNC_OUT_HZ=50                # common output grid
SYNC_LATENESS_MS=25           # watermark slack for reordered samples
# Leave these empty to run with the built-in in-process queue/cache (no infrastructure needed).
KAFKA_BROKERS=                # e.g. localhost:9092
REDIS_URL=                    # e.g. redis://127.0.0.1:6379
