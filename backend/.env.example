# Backend HTTP + Socket.IO port
PORT=5000

# MATLAB/Simulink posts newline-delimited JSON step packets to this port.
# Must be 0.0.0.0 (not 127.0.0.1) when the sender runs on a second laptop.
# On the backend machine, open the port once, from an elevated shell:
#   netsh advfirewall firewall add rule name="SCADA backend HTTP" dir=in action=allow protocol=TCP localport=5000
#   netsh advfirewall firewall add rule name="SCADA feeder TCP"   dir=in action=allow protocol=TCP localport=6000
TCP_HOST=0.0.0.0
TCP_PORT=6000

# Reserved for the planned UDP ingestion listener. Not wired up yet; ingestion is
# transport-agnostic, so a UDP listener only has to call ingestMeasurement().
UDP_PORT=6001

# The database name matters: without one, Mongoose silently falls back to "test".
MONGODB_URI=mongodb://127.0.0.1:27017/scada

ML_SERVICE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173

# One step = 15 simulated minutes. HISTORY_L is how many stored steps a bus needs
# before it is forecast; HORIZON_H is how many steps ahead the ML service predicts.
HISTORY_L=12
HORIZON_H=12

# Comma-separated bus ids that get an automatic forecast after each stored step.
MONITORED_BUSES=150,1,13,67,83,114

# Provenance gate. "simulink-qsts" is always accepted; packets declaring
# "matlab-test", "demo" or "mock" are rejected unless this is true, so a
# production dashboard can never silently show generated values.
ALLOW_TEST_DATA=false

# POST /api/replay/start only reads QSTS CSV files inside this directory
# (default: backend/data). Drop the CSV there and pass its name as csvPath.
REPLAY_DIR=
